{
  "name": "pixel-adventure",
  "version": "3.0.0-rc.1",
  "description": "A colorful pixel-art platformer built with Phaser 3 and Vite.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test test/*.test.js",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --config desktop/builder.json --win nsis --x64 --publish never",
    "test:browser": "node test/browser-smoke.cjs",
    "test:touch": "node test/touch-controls.cjs",
    "test:desktop": "node test/desktop-smoke.cjs"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "playwright-core": "1.65.1",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "desktop/main.cjs",
  "author": "Pixel Adventure",
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.8"
    },
    "@electron/universal": {
      "minimatch": "11.0.8"
    }
  }
}
